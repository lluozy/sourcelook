{
    "name": "@local/sourcelook",
    "version": "1.5.113",
    "author": "Luozy",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "description": "A full-window source reader and editor for the current Session workspace.",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.svg"
    },
    "files": [
        "index.js",
        "client.js",
        "host/**",
        "renderer-lib/**",
        "vendor/**",
        "src/**",
        "scripts/**",
        "locale/*.json",
        "icon.svg",
        "cordis.patch.yml",
        "README.md"
    ],
    "engines": {
        "dsh": ">=0.2.2-rc.1"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "check": "node --check host/files.mjs && node --check host/static.mjs && node --check host/fs-service.js && node --check host/ts-indexer.js && node --check index.js && node --check client.js",
        "smoke": "node scripts/smoke-host.mjs && node scripts/smoke-index.cjs"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "@deepseek-ai/dsh-client-ui-layout",
                "@deepseek-ai/dsh-client-locale"
            ]
        }
    }
}
